# =============================================
# BANGPAN PRO — 환경변수 설정
# 복사 후 .env.local 로 저장
# =============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 회사 설정
NEXT_PUBLIC_COMPANY_NAME=회사명
NEXT_PUBLIC_COMPANY_CODE=COMPANY_CODE

# 관리자
ADMIN_EMAIL=admin@company.com

# 앱 설정
NEXT_PUBLIC_APP_URL=https://your-domain.com

# 주민번호 암호화 키 (반드시 설정 — 미설정 시 하드코딩 기본값 사용되어 보안 위험)
# 32바이트 이상의 랜덤 문자열로 설정하세요
# 예시: openssl rand -base64 32
RESIDENT_ENC_KEY=your-32-byte-or-longer-secret-key-here
